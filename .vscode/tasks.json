{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch All (BuildRunner & Slang)",
      "dependsOn": [
        "Watch BuildRunner",
        "Watch Slang"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Watch BuildRunner",
      "type": "shell",
      "command": "dart run build_runner watch --delete-conflicting-outputs"
    },
    {
      "label": "Watch Slang",
      "type": "shell",
      "command": "dart run slang watch"
    }
  ]
}